{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vscode: watch",
      "type": "npm",
      "script": "watch",
      "path": "vscode",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}/vscode"],
        "pattern": {
          "regexp": "^error: (.+):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
