{
  "name": "unharnessed",
  "displayName": "Unharnessed",
  "description": "Chat with the Unharnessed agent from VS Code.",
  "version": "0.0.3",
  "publisher": "Unharnessed",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1a1b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Paseru/Unharnessed.git"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "unharnessed.open",
        "title": "Open Unharnessed",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "unharnessed.open",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "unharnessed",
          "title": "Unharnessed",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "unharnessed": [
        {
          "type": "webview",
          "id": "unharnessed.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "~1.110.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "simple-icons": "16.34.0",
    "thinking-orbs": "0.3.2",
    "typescript": "^7.0.2"
  }
}
