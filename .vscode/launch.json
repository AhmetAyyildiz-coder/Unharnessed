{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Unharnessed extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/vscode/dist/**/*.js"],
      "preLaunchTask": "vscode: watch"
    }
  ]
}
